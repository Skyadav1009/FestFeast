# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/festfeast?retryWrites=true&w=majority

# Server port
PORT=5000

# Node environment
NODE_ENV=development

# Scraper settings
# Use SCRAPE_INTERVAL_MINUTES for minute intervals (e.g., 5 = every 5 mins)
# Or use SCRAPE_INTERVAL_HOURS for hourly intervals (default: 6)
# SCRAPE_INTERVAL_MINUTES=5
SCRAPE_INTERVAL_HOURS=1

# Optional: API key for protected routes (POST /scrape)
API_KEY=your-secret-api-key-here
